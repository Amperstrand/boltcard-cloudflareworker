{
  "name": "boltcard-poc",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "aes-js": "3.1.2",
    "better-sqlite3": "12.9.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.0",
    "@noble/hashes": "2.3.0",
    "@noble/secp256k1": "3.1.0",
    "@ntag424/crypto": "github:Amperstrand/ntag424-crypto#v1.0.0",
    "@scure/base": "^2.2.0",
    "itty-router": "5.0.23",
    "valibot": "^1.4.2"
  },
  "scripts": {
    "prebuild": "node scripts/build_keys.js",
    "test": "vitest run",
    "test:do": "vitest run --config vitest.do.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm test && npm run test:do && npm run test:integration",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "typecheck:src": "tsc --noEmit --project tsconfig.build.json",
    "lint:innerhtml": "node scripts/check-innerhtml.js",
    "lint:static-script": "node scripts/check-static-script.js",
    "lint:build-info": "node scripts/check-build-info.js",
    "lint": "npm run lint:innerhtml && npm run lint:static-script && npm run lint:build-info",
    "live:smoke": "node scripts/live-smoke-test.mjs",
    "cf-typegen": "wrangler types",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o public/static/css/tailwind.css --minify && node scripts/sync-tailwind-css.mjs",
    "test:evidence": "npx playwright test && node scripts/render-test-dashboard.mjs",
    "test:evidence:local": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:8787 npx playwright test && node scripts/render-test-dashboard.mjs",
    "test:publish": "python3 scripts/publish/publish_evidence.py --nsec-file ../hackathon-tooling/.orchestrator-nsec",
    "deploy": "node scripts/sync-js-exports.mjs && npm run build:css && npm test && npm run test:do && npm run test:integration && npm run typecheck && npm run lint && node scripts/build_keys.js && wrangler deploy && npm run live:smoke",
    "prepare": "husky"
  }
}
